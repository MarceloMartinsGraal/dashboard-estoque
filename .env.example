# Copie para .env e preencha localmente. Nunca inclua credenciais no Git.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
SESSION_SECRET=
POSTGRES_USER=graal_owner
POSTGRES_DB=graal
POSTGRES_PASSWORD=
# Gere hex aleatório para permitir interpolação segura na URL:
DB_APP_PASSWORD=
DATABASE_URL=postgresql://graal_app:SUBSTITUA_PELO_DB_APP_PASSWORD@127.0.0.1:5432/graal

# Integração habilitada quando ausente/true; false desabilita explicitamente. Credenciais continuam obrigatórias.
INTEGRATION_ENABLED=true
# Exemplo fictício de instância na documentação: glpi-exemplo (não é uma URL).
# Authorization: Bearer <UUID_DO_CLIENTE>.<SEGREDO_LOCAL_NAO_PREENCHIDO>

# Configurador de homologação: preenche estes valores no .env quando executado.
# GRAAL_SETUP_MODE=homologacao
# DASHBOARD_IP=192.168.1.50
# DASHBOARD_PORT=8080
# COMPOSE_PROJECT_NAME=graal-homologacao
# GLPI_SSH_HOST=192.168.1.106
# GLPI_SSH_USER=usuario_autorizado
# GLPI_SSH_PORT=22
# GLPI_SSH_KEY=/caminho/da/chave
# GLPI_DIR=/var/www/glpi
# GLPI_WEB_USER=www-data
# GLPI_INSTANCE_ID=glpi-homologacao
# INTEGRATION_TOKEN_FILE=.local-setup/integration-token

# Execução nativa: diretório privado persistente dos PDFs. No Docker a imagem usa /var/lib/graal/invoices com volume dedicado.
INVOICE_STORAGE_DIR=./var/invoices

# GLPI no próprio servidor Ubuntu: usar --glpi-local; padrão legado é ssh.
# GLPI_CONNECTION=local
# URL que o processo PHP do GLPI alcança, independente do endereço do navegador:
# GLPI_API_BASE_URL=http://127.0.0.1:8080/api/integration/v1
# Online em servidor compartilhado: GRAAL_SETUP_MODE=production, NODE_ENV=production,
# PUBLIC_ORIGIN=https://DOMINIO_DASHBOARD, DASHBOARD_IP=127.0.0.1 e compose.same-host.yaml.
# Rede privada: GRAAL_SETUP_MODE=homologacao e compose.homologacao.yaml.

# Copie para .env e preencha localmente. Nunca inclua credenciais no Git.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
SESSION_SECRET=
POSTGRES_USER=graal_owner
POSTGRES_DB=graal
POSTGRES_PASSWORD=
# Gere hex aleatório para permitir interpolação segura na URL:
DB_APP_PASSWORD=
DATABASE_URL=postgresql://graal_app:SUBSTITUA_PELO_DB_APP_PASSWORD@127.0.0.1:5432/graal

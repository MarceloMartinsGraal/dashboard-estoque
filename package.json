{
  "name": "graal-estoque",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "tsc -p backend/tsconfig.json && vite build --config frontend/vite.config.mts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json",
    "start": "node --env-file=.env dist/backend/main.js",
    "dev:api": "node --env-file=.env --watch dist/backend/main.js",
    "dev:web": "vite --config frontend/vite.config.mts",
    "migrate": "node --env-file=.env dist/backend/migrate.js",
    "bootstrap": "node --env-file=.env dist/backend/bootstrap.js",
    "test": "npm run build:backend && node --test --test-concurrency=1 tests/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "pg": "8.23.1",
    "argon2": "0.45.1",
    "express-session": "1.19.0",
    "connect-pg-simple": "10.0.0",
    "helmet": "8.3.0",
    "zod": "4.6.7",
    "jsonc-parser": "3.3.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/connect-pg-simple": "7.0.3",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1"
  }
}

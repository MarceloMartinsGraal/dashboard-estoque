  "components": {
    "securitySchemes": {
      "IntegrationBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "UUID.secret-hex-64",
        "description": "Cliente revogável e expirável; hash no banco. Cookie não autentica. Placeholders da documentação não são segredos utilizáveis."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "statusCode",
          "message"
        ],
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Quantity": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{3}$",
        "example": "2.000",
        "description": "Decimal canônico; duas unidades. Regra atual aceita apenas inteiros; sem float."
      },
      "ExternalReference": {
        "type": "object",
        "required": [
          "instanceId",
          "ticketId",
          "externalUserId"
        ],
        "properties": {
          "instanceId": {
            "type": "string"
          },
          "ticketId": {
            "type": "string"
          },
          "externalUserId": {
            "type": "string"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "description",
          "unit",
          "active",
          "legacyId",
          "quantity",
          "openingDate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "const": "unidade"
          },
          "active": {
            "type": "boolean"
          },
          "legacyId": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          },
          "openingDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          }
        }
      },
      "Balances": {
        "type": "object",
        "required": [
          "productId",
          "unit",
          "active",
          "openingDate",
          "total",
          "locations"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "unit": {
            "const": "unidade"
          },
          "active": {
            "type": "boolean"
          },
          "openingDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "$ref": "#/components/schemas/Quantity"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location"
            }
          }
        }
      },
      "CreateProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "active",
          "externalUserId"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "active": {
            "type": "boolean"
          },
          "externalUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "unit": {
            "type": "string",
            "enum": [
              "unidade"
            ],
            "default": "unidade"
          },
          "categoryId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "default": null
          },
          "subcategoryId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "default": null
          }
        }
      },
      "CreatedProduct": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "CreateMovement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "kind",
          "quantity",
          "eventDate",
          "locationId",
          "reason",
          "ticketId",
          "externalUserId"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "entrada",
              "saida"
            ]
          },
          "quantity": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,12}(\\.0{1,3})?$",
            "maxLength": 24,
            "description": "Positiva, inteira, máximo 9000000000000; zero é rejeitado."
          },
          "eventDate": {
            "type": "string",
            "format": "date",
            "description": "Data real, não futura e não anterior à abertura operacional do produto."
          },
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "enum": [
              "chamado",
              "uso_interno",
              "rma",
              "outro",
              "correcao_estoque",
              "recebimento"
            ]
          },
          "ticketId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "externalUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "observation": {
            "type": "string",
            "maxLength": 2000,
            "description": "Obrigatória para outro ou correcao_estoque"
          }
        }
      },
      "MovementResult": {
        "type": "object",
        "required": [
          "id",
          "productId",
          "kind",
          "quantity",
          "eventDate",
          "recordedAt",
          "actorId",
          "locationId",
          "reason",
          "observation",
          "externalReference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "entrada",
              "saida"
            ]
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          },
          "eventDate": {
            "type": "string",
            "format": "date"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "locationId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          },
          "observation": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalReference": {
            "$ref": "#/components/schemas/ExternalReference"
          }
        }
      },
      "Operation": {
        "type": "object",
        "required": [
          "idempotencyKey",
          "instanceId",
          "operation",
          "result",
          "created_at"
        ],
        "properties": {
          "idempotencyKey": {
            "type": "string"
          },
          "instanceId": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "movement",
              "product"
            ]
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MovementResult"
              },
              {
                "$ref": "#/components/schemas/CreatedProduct"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HistoryItem": {
        "type": "object",
        "description": "Contrato reaproveitado do histórico operacional, com vínculos externos. Campos legados permanecem null/false neste endpoint. Quantidade/deltas decimais canônicos.",
        "required": [
          "id",
          "product_id",
          "kind",
          "quantity",
          "event_date",
          "recorded_at",
          "author",
          "actor_id",
          "locations",
          "regime",
          "reversal_of",
          "reversed_by",
          "externalReference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          },
          "event_date": {
            "type": "string",
            "format": "date"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "ticket": {
            "type": [
              "string",
              "null"
            ]
          },
          "observation": {
            "type": [
              "string",
              "null"
            ]
          },
          "regime": {
            "const": "operacional"
          },
          "flow": {
            "type": "string"
          },
          "reversal_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "reversed_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "externalReference": {
            "$ref": "#/components/schemas/ExternalReference"
          },
          "locations": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Location"
                },
                {
                  "type": "object",
                  "required": [
                    "delta"
                  ],
                  "properties": {
                    "delta": {
                      "type": "string",
                      "pattern": "^-?[0-9]+\\.[0-9]{3}$"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "Products": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "Locations": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "History": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Dashboard Graal — Integração v1",
    "version": "1.0.0",
    "description": "Dashboard preparado para integração. Sem plugin ou chamadas GLPI. Desabilitado por padrão. Instância determinada pela credencial; permissões GLPI devem ser verificadas pelo futuro servidor do plugin. Ver integration-v1.md para erros e exemplos. O catálogo/estoque é compartilhado; referências de chamados e resultados idempotentes são isolados por instância."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/integration/v1",
      "description": "Somente desenvolvimento local; futura publicação exige HTTPS."
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "summary": "Buscar produtos inclusive sem saldo, sem caixa/acentos portugueses",
        "security": [
          {
            "IntegrationBearer": []
          }
        ],
        "x-required-scope": "read",
        "responses": {
          "400": {
            "description": "Dados/chave inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente/inválida/revogada/expirada; revalidação transacional pode detectar perda de permissão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Escopo insuficiente ou vínculo/funcionário inativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Integração desabilitada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna genérica",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Consulta concluída",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Products"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": ""
            }
          }
        ],
        "description": "Catálogo único compartilhado entre instâncias autorizadas, inclusive produtos sem saldo. A instância isola apenas vínculos externos e resultados idempotentes."
      },
      "post": {
        "summary": "Cadastrar explicitamente; sem gerar saldo",
        "security": [
          {
            "IntegrationBearer": []
          }
        ],
        "x-required-scope": "products:write",
        "responses": {
          "400": {
            "description": "Dados/chave inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente/inválida/revogada/expirada; revalidação transacional pode detectar perda de permissão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Escopo insuficiente ou vínculo/funcionário inativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Saldo insuficiente, abertura pendente, referência inválida ou conflito de idempotência",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Integração desabilitada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna genérica",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Resultado original; replay preserva a resposta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedProduct"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,120}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              }
            }
          }
        },
        "description": "Cadastra produto sem quantidade. Inicializa base zero na data do cadastro (America/Sao_Paulo), sem movimento ou ledger. Primeira entrada é operação separada em POST /movements; produtos existentes e legados não são alterados."
      }
    },
